FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl wget netcat iputils-ping \
    net-tools iproute2 \
    python3 python3-pip \
    tcpdump socat hping3 nmap \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip && pip3 install requests scapy

COPY benign_traffic.py /benign_traffic.py
RUN chmod +x /benign_traffic.py

# -u flag forces unbuffered output
CMD ["python3", "-u", "/benign_traffic.py"]
